# ---------------------------------------------------------------------------
# AveonTrade Web — server-side broker configuration
# Copy this file to .env.local and fill in real values.
# These are read ONLY on the server (API routes), never shipped to the browser,
# mirroring how the Flutter app kept apiKey out of the client bundle.
# ---------------------------------------------------------------------------

# Broker REST API base URL (same backend the Flutter app talks to)
AVEON_BASE_URL=

# Tenant id issued by the broker
AVEON_TENANT_ID=

# Broker API key — provision via your hosting platform's secret manager in
# production. Never commit a real key to source control.
AVEON_API_KEY=

# Comma separated hostnames this server is allowed to call. Requests to any
# other host are rejected by the proxy in src/app/api/broker/[...path]/route.ts
AVEON_ALLOWED_HOSTS=

# Optional dedicated chart API host (Synapsewave). Leave blank to fall back
# to Yahoo history in the chart module.
AVEON_CHART_BASE_URL=

# App metadata sent on every broker request (mirrors AppConfig in Flutter,
# and confirmed against a known-working reference client)
AVEON_SOURCE=MOBILEAPI
AVEON_VERSION=2.0.0
AVEON_UDID=web-aveon

# Name of the cookie used to store the signed-in session (httpOnly)
SESSION_COOKIE_NAME=aveon_session

# Required in production: a random 32+ character secret used to make the
# httpOnly session cookie tamper-evident. Store it in your platform secret manager.
SESSION_SIGNING_SECRET=

